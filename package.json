{
  "name": "orb-masters",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ORB MASTERS multi-mode arcade PWA",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs --release",
